using System;

namespace ExpenseTrackingModule
{
    // Expense class represents one expense
    class Expense
    {
        // Variables to store expense name and amount
        public string ExpenseName;
        public double Amount;

        // Constructor to initialize expense details
        public Expense(string name, double amount)
        {
            ExpenseName = name;
            Amount = amount;
        }

        // Method to display expense details
        public void DisplayExpense()
        {
            Console.WriteLine("\nExpense Details");
            Console.WriteLine("-------------------------");
            Console.WriteLine("Expense Name : " + ExpenseName);
            Console.WriteLine("Amount       : Rs. " + Amount);
        }
    }

    // Main Program class
    class Program
    {
        // Main method - program execution starts here
        static void Main(string[] args)
        {
            try
            {
                // Ask user to enter expense name
                Console.Write("Enter Expense Name : ");
                string name = Console.ReadLine();

                // Ask user to enter expense amount
                Console.Write("Enter Amount : ");
                double amount = Convert.ToDouble(Console.ReadLine());

                // Check whether amount is greater than zero
                if (amount <= 0)
                {
                    // Throw an exception if amount is invalid
                    throw new Exception("Amount must be greater than zero.");
                }

                // Create an object of Expense class
                Expense obj = new Expense(name, amount);

                // Display the entered expense details
                obj.DisplayExpense();
            }

            // Handles invalid numeric input
            catch (FormatException)
            {
                Console.WriteLine("\nInvalid Input! Please enter numeric value.");
            }

            // Handles other exceptions
            catch (Exception ex)
            {
                Console.WriteLine("\nError : " + ex.Message);
            }

            // This block always executes
            finally
            {
                Console.WriteLine("\nProgram Finished Successfully.");
            }

            // Wait for user to press a key
            Console.ReadKey();
        }
    }
}
