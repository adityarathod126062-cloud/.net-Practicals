    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background-color: #f4f6f9;
        }

        header {
            background-color: #172554;
            color: white;
            text-align: center;
            padding: 20px;
        }

        main {
            background-color: white;
            max-width: 650px;
            margin: 30px auto;
            padding: 30px;
            border-radius: 8px;
        }

        .form-control {
            width: 100%;
            box-sizing: border-box;
            padding: 8px;
            border: 1px solid #ccc;
            border-radius: 4px;
        }

        .btn-primary {
            display: inline-block;
            background-color: #1d4ed8;
            color: white;
            padding: 10px 16px;
            border: none;
